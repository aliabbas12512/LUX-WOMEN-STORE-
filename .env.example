# ─── Public site ────────────────────────────────────────────────
# Full production URL, no trailing slash. Used for canonical URLs, sitemap,
# social sharing and product links inside WhatsApp messages.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# WhatsApp Business number in international format, digits only
# (e.g. 9665XXXXXXXX). Leave empty until you have a real number —
# the WhatsApp buttons stay hidden in production while it is empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional public contact details shown in the footer / contact page.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_SNAPCHAT_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Hostnames allowed for product photos served by next/image (comma separated),
# e.g. abcd.supabase.co,cdn.yourbrand.com
NEXT_PUBLIC_IMAGE_HOSTS=

# ─── Snapchat Pixel ─────────────────────────────────────────────
# Pixel ID from Snapchat Ads Manager → Events Manager.
NEXT_PUBLIC_SNAP_PIXEL_ID=
# "true" (default) shows a consent bar and loads the pixel only after the
# visitor accepts. Set to "false" only if your legal review allows it.
NEXT_PUBLIC_TRACKING_CONSENT_REQUIRED=true

# ─── Order storage (server only — never expose these) ───────────
# Orders are saved when at least one destination is configured. Without one,
# the checkout becomes an order request that the customer sends via WhatsApp,
# and no purchase conversion is fired.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: also POST each order as JSON to a webhook (Make, Zapier, n8n…).
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_SECRET=
